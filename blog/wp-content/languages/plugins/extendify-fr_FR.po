#: app/Onboarding/Admin.php:77
msgid "Welcome"
msgstr "Bienvenue"

#: app/Onboarding/Controllers/WPController.php:62
msgid "Error creating theme.json file"
msgstr "Erreur lors de la création du fichier theme.json"

#: app/Onboarding/Controllers/WPController.php:29
